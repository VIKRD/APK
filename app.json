{
  "expo": {
    "name": "GroceryApp",
    "slug": "vik19rd",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#080a0d"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.groceryapp",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Приложению нужен доступ к галерее для выбора фото товаров."
      }
    },
    "android": {
      "package": "com.anonymous.groceryapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#080a0d"
      },
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Приложению нужен доступ к галерее для выбора фото товаров."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "07dda072-f94b-4bde-a068-cd5a0e38d5de"
      }
    }
  }
}
